# ===========================================================================
# Lenny Growth Assistant — configuration
# Copy to .env  (cp .env.example .env). Safe defaults: the app runs with NO
# secrets at all using Ollama. Never commit .env.
# ===========================================================================

# ---- LLM provider toggle ---------------------------------------------------
# Which provider answers by default: "ollama" (local, no key) or "anthropic" (cloud).
# The UI can switch per conversation; this is the initial/default choice.
LLM_PROVIDER=ollama
# If the chosen provider is unhealthy (no key / Ollama down / model not pulled),
# fall back to this one when it is healthy. Set empty to disable fallback.
LLM_FALLBACK_PROVIDER=anthropic
# Agent runtime: auto | agent_sdk | messages_loop
#   auto = Claude Agent SDK for anthropic, lean Messages-API loop for ollama (recommended)
AGENT_RUNTIME=auto

# ---- Cloud: Anthropic (optional) ------------------------------------------
# Required only if you want the "Cloud" toggle to work. Get one at console.anthropic.com
ANTHROPIC_API_KEY=
# Model IDs: claude-sonnet-5 (default, best cost/quality here), claude-opus-5, claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Local: Ollama (mandatory for the demo) --------------------------------
# Where the API reaches Ollama. From Docker use host.docker.internal; from a
# bare `uvicorn` run use http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Chat model. 7B runs comfortably on a 16 GB laptop; use qwen2.5:3b or llama3.2:3b on 8 GB.
OLLAMA_MODEL=qwen2.5:7b
# Embedding model for semantic retrieval (274 MB). Retrieval still works without it (lexical).
OLLAMA_EMBED_MODEL=nomic-embed-text
# Compute embeddings in the background after ingest (needs Ollama). true|false
EMBEDDINGS_ENABLED=true

# ---- Timeouts & limits -----------------------------------------------------
# Per-request read timeout. Local CPU models may need minutes before the first token.
LLM_TIMEOUT_S=300
LLM_MAX_TOOL_ROUNDS=6
LLM_MAX_OUTPUT_TOKENS=2048
# Artifact generation needs a bigger ceiling than a chat turn — on a cloud
# reasoning model the budget is shared with thinking tokens, so too low a value
# truncates the document mid-sentence.
ARTIFACT_MAX_OUTPUT_TOKENS=8000

# ---- Local-model budgets (optional) ----------------------------------------
# A 7B CPU model needs smaller everything than a cloud model. These override the
# values above whenever the active provider is ollama; the defaults below are
# tuned for qwen2.5:7b on a 16 GB laptop and rarely need changing.
# Let the local model call tools itself. Off by default: small models loop.
OLLAMA_TOOLS_ENABLED=false
# Output ceiling for a local chat turn.
OLLAMA_MAX_OUTPUT_TOKENS=800
# Output ceiling for a local artifact/essay.
OLLAMA_ARTIFACT_MAX_OUTPUT_TOKENS=2600
# Warn on /health/ready if Ollama's context window is below this (set
# OLLAMA_CONTEXT_LENGTH=8192 in Ollama's own environment to satisfy it).
OLLAMA_MIN_CONTEXT=8192
# Passages retrieved per local turn — fewer than cloud, to keep the prompt small.
OLLAMA_RETRIEVAL_TOP_K=4
# Conversation history budget, in tokens, before older turns are dropped.
HISTORY_BUDGET_TOKENS=2200
OLLAMA_HISTORY_BUDGET_TOKENS=1200

# ---- Database ---------------------------------------------------------------
# Docker Compose wires DATABASE_URL automatically. For Supabase / Railway / bare-metal
# set the asyncpg URL explicitly, e.g.
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
# (Supabase: enable the "vector" extension under Database → Extensions first.)
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny
# Connection pool. Raise DB_POOL_SIZE for more concurrent chats; raise the
# connect timeout for a remote managed Postgres (Supabase/Railway).
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_S=10

# ---- Knowledge base ---------------------------------------------------------
# Transcripts are cloned from this repo on first boot into TRANSCRIPTS_DIR.
TRANSCRIPTS_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts.git
# Where the clone lands inside the API container (a named Docker volume, so it
# survives rebuilds). Point it at an existing checkout to skip the clone.
TRANSCRIPTS_DIR=/app/data/transcripts
# Ingest only the first N episodes (0 = all 300). Handy for a fast first look.
INGEST_EPISODE_LIMIT=0
# Ingest automatically on startup when the knowledge base is empty.
AUTO_INGEST_ON_START=true
CHUNK_TARGET_TOKENS=350
# Speaker turns of overlap between adjacent chunks, so an answer that straddles
# a chunk boundary is still retrievable.
CHUNK_OVERLAP_TURNS=1
RETRIEVAL_TOP_K=6
# Cosine-similarity floor for vector hits. Nearest-neighbour search always
# returns *something*; without a floor, "the transcripts don't cover this" can
# never happen.
VECTOR_MIN_SIMILARITY=0.45
# Embedding worker: batch size per Ollama call, and the vector width the schema
# was created with. Changing EMBEDDING_DIM requires re-creating the chunks table.
EMBED_BATCH_SIZE=32
EMBEDDING_DIM=768

# ---- App --------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
# json (machine-readable, default in Docker) | console (pretty, for local dev)
LOG_FORMAT=json
API_PORT=8000
WEB_PORT=3000
# Largest artifact the sanitizer will store; anything longer is truncated and
# flagged in the sanitize report.
ARTIFACT_MAX_BYTES=200000
# Browser origins allowed to call the API, comma-separated. Defaults cover the
# Vite dev server and the Compose web container; add your real web origin before
# exposing the API beyond localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
