# ===========================================================================
# Lenny Growth Assistant — configuration
# Copy to .env  (cp .env.example .env). Safe defaults: the app runs with NO
# secrets at all using Ollama. Never commit .env.
# ===========================================================================

# ---- LLM provider toggle ---------------------------------------------------
# Which provider answers by default: "ollama" (local, no key) or "anthropic" (cloud).
# The UI can switch per conversation; this is the initial/default choice.
LLM_PROVIDER=ollama
# If the chosen provider is unhealthy (no key / Ollama down / model not pulled),
# fall back to this one when it is healthy. Set empty to disable fallback.
LLM_FALLBACK_PROVIDER=anthropic
# Agent runtime: auto | agent_sdk | messages_loop
#   auto = Claude Agent SDK for anthropic, lean Messages-API loop for ollama (recommended)
AGENT_RUNTIME=auto

# ---- Cloud: Anthropic (optional) ------------------------------------------
# Required only if you want the "Cloud" toggle to work. Get one at console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Local: Ollama (mandatory for the demo) --------------------------------
# Where the API reaches Ollama. From Docker use host.docker.internal; from a
# bare `uvicorn` run use http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Chat model. 7B runs comfortably on a 16 GB laptop; use qwen2.5:3b or llama3.2:3b on 8 GB.
OLLAMA_MODEL=qwen2.5:7b
# Embedding model for semantic retrieval (274 MB). Retrieval still works without it (lexical).
OLLAMA_EMBED_MODEL=nomic-embed-text
# Compute embeddings in the background after ingest (needs Ollama). true|false
EMBEDDINGS_ENABLED=true

# ---- Timeouts & limits -----------------------------------------------------
LLM_TIMEOUT_S=120
LLM_MAX_TOOL_ROUNDS=6
LLM_MAX_OUTPUT_TOKENS=2048

# ---- Database ---------------------------------------------------------------
# Docker Compose wires DATABASE_URL automatically. For Supabase / Railway / bare-metal
# set the asyncpg URL explicitly, e.g.
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
# (Supabase: enable the "vector" extension under Database → Extensions first.)
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny

# ---- Knowledge base ---------------------------------------------------------
# Transcripts are cloned from this repo on first boot into TRANSCRIPTS_DIR.
TRANSCRIPTS_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts.git
# Ingest only the first N episodes (0 = all 300). Handy for a fast first look.
INGEST_EPISODE_LIMIT=0
# Ingest automatically on startup when the knowledge base is empty.
AUTO_INGEST_ON_START=true
CHUNK_TARGET_TOKENS=350
RETRIEVAL_TOP_K=6
VECTOR_MIN_SIMILARITY=0.45

# ---- App --------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
# json (machine-readable, default in Docker) | console (pretty, for local dev)
LOG_FORMAT=json
API_PORT=8000
WEB_PORT=3000
ARTIFACT_MAX_BYTES=200000
